# Barcode Cafe: serve the PHP site first (an old static index.html may still exist on the server)
DirectoryIndex index.php index.html
Options -Indexes
<IfModule mod_headers.c>
  <FilesMatch "\.(php|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
# private folders: data seeds, shared code and live storage are never served
RedirectMatch 404 ^.*/(data|inc|storage)/.*$
<FilesMatch "\.(json|lock|md|gz|tmp|log|bak|sql|ini|sh)$">
  Require all denied
</FilesMatch>

# security: hide dotfiles, no MIME sniffing
RedirectMatch 404 /\.(?!well-known)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
</IfModule>
