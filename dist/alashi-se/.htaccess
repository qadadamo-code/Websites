# alashi.se – generated by clients/alashi/src/build.py
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# HTTPS + no www
# (also catches the copy that lands on web.theplanetco.com/alashi-se/)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^alashi\.se$ [NC]
RewriteRule ^(.*)$ https://alashi.se/$1 [R=301,L]

# Old WordPress URLs -> new pages (keeps link value)
RewriteRule ^services/skomakeri-nyckelservice/?$ /skomakare-umea/ [R=301,L]
RewriteRule ^services/skomakeri/?$ /skomakare-umea/ [R=301,L]
RewriteRule ^services/skradderi/?$ /skraddare-umea/ [R=301,L]
RewriteRule ^services/kemtvatt/?$ /kemtvatt-umea/ [R=301,L]
RewriteRule ^services/nyckelservice/?$ /nyckelkopiering-umea/ [R=301,L]
RewriteRule ^contacts/?$ /kontakt/ [R=301,L]
RewriteRule ^services/?$ /#tjanster [R=301,L,NE]

# Hacked spam pages from the old WordPress: tell Google they are gone for good (410)
RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json|xmlrpc\.php|wp-login\.php|feed|comments/feed|author|category|tag|blog-[a-z0-9-]+|about-style-[0-9]+)(/.*)?$ - [G,L]
RewriteCond %{QUERY_STRING} (^|&)(p|s|cat|page_id|attachment_id)= [NC]
RewriteRule ^ - [G,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(en|kontakt|om-oss|integritetspolicy|skomakare-umea|skraddare-umea|kemtvatt-umea|nyckelkopiering-umea)(/|$)
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^ - [G,L]
</IfModule>
ErrorDocument 410 /404.html

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Strict-Transport-Security "max-age=31536000"
<FilesMatch "\.(css|js|woff2|svg|png|jpg|webp|ico)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json application/xml text/xml
</IfModule>
AddType application/manifest+json .webmanifest
