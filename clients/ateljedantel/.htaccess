# Ateljé Dantel webshop (PHP + JSON storage)
DirectoryIndex index.php
Options -Indexes
ErrorDocument 404 /ateljedantel/404.php
<IfModule mod_headers.c>
  <FilesMatch "\.(php|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|svg|woff2|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
</IfModule>
# private folders: seeds, shared code and live storage are never served
RedirectMatch 404 ^.*/(data|inc|storage)(/.*)?$
<FilesMatch "\.(json|lock|md|gz|tmp|log|bak|sql|ini|sh)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.(?!well-known)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
